# Cyacle 前端部署能力开关。
# Vite 会在构建时读取这些 VITE_* 变量并写入前端产物；修改后需要重新构建。
# 所有变量只允许填写 true 或 false；未配置时，除新报告入口默认关闭外，其余开关默认开启。
# VITE_* 会暴露给浏览器，请勿在此配置密钥、Token 等敏感信息。

# 是否开启 Agent 协作能力。关闭后不初始化 Agent 前端运行时，也不渲染全局 Agent 入口。
VITE_APP_AGENT_ENABLED=true

# 是否显示语言切换入口，包括登录页和登录后的账户菜单。
VITE_APP_LANGUAGE_SWITCHER_ENABLED=true

# 是否开启数据记录的地图测算能力。
# 关闭后隐藏“运输距离”创建入口，不查询地图测算详情，也不加载地图组件调用第三方地图 API。
VITE_APP_DATA_RECORD_MAP_ENABLED=true

# 是否显示核算详情中的新报告入口，适用于 CFP 和 LCA。
# 未配置时默认关闭。
VITE_APP_REPORT_NEW_ENABLED=false
